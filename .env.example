# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# Google Gemini API (Optional - for AI features)
# Get an API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Application Mode
# Set to 'demo' to use mock data, 'production' to use real Supabase backend
# Note: The app will automatically use demo mode if Supabase credentials are not configured
MODE=demo
